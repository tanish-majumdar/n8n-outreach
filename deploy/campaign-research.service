[Unit]
Description=Campaign research (scheduler + API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Ubuntu EC2 AMI: the login user is `ubuntu`. If you deploy somewhere the login
# user differs (Amazon Linux uses `ec2-user`), change all three paths below.
User=ubuntu
WorkingDirectory=/home/ubuntu/n8n-outreach
ExecStart=/home/ubuntu/.bun/bin/bun run src/main.ts

# There is no EnvironmentFile. Bun loads .env from WorkingDirectory automatically,
# so the secrets live in /home/ubuntu/n8n-outreach/.env (chmod 600).
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=campaign-research

# Hardening that costs no extra setup steps. Do NOT add ProtectHome - the code,
# the .env and state/ all live under $HOME. Do NOT add ProtectSystem=strict - it
# would force a ReadWritePaths entry for state/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
