# Server .env. On the EC2 box:
#
#   cp deploy/campaign-research.env.example .env
#   chmod 600 .env
#   nano .env
#
# This is an ordinary .env - Bun loads it from the working directory at boot. It
# is NOT a systemd EnvironmentFile: values may contain spaces unquoted (SCHEDULE
# below is fine as-is) and trailing comments are stripped.
#
# One footgun: a `#` inside an unquoted value truncates it - `TOKEN=ab#cd` parses
# as `ab`. Quote any secret containing `#`: TOKEN="ab#cd". Quoting is always safe.
#
# .env is gitignored, so `git pull` never touches it. It holds the refresh token:
# chmod 600 is not optional.

# ── Google (OAuth only) ───────────────────────────────────────────────────
# Generate these on your laptop with `bun run cli auth` - the flow needs a
# browser, so it cannot be done over SSH. Copy the three values it prints.
# There is no key file to copy to the server.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ── Spreadsheet ───────────────────────────────────────────────────────────
MASTER_EVENTS_ID=17i2-7FAstpuwGvIc6ugTtDL0ycax9W6E-gq9R7SF-8I
CAMPAIGNS_TAB=CAMPAIGNS

# ── Search ────────────────────────────────────────────────────────────────
TINYFISH_API_KEY=
SEARCH_LOCATION=IN

# ── Model (Cloudflare Workers AI, OpenAI-compatible endpoint) ─────────────
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# A reasoning model is required: the job is judging whether an organisation fits
# the brief, which small instruct models get wrong. Reasoning tokens come out of
# the same budget as the answer, so the limits below are deliberately generous -
# too small and the model spends everything thinking and returns nothing.
#   glm-5.2         quality pick, fills evidence fields, ~35s per extraction
#   gpt-oss-120b    ~8x faster but leaves attendance/event_goal empty
#   glm-4.7-flash   do not use, returns nothing
#   kimi-k2.6       do not use, 100s+ and unreliable
CF_MODEL=@cf/zai-org/glm-5.2
CF_STRUCTURED_OUTPUTS=true
MAX_QUERY_TOKENS=24000
MAX_EXTRACT_TOKENS=96000

# ── HTTP API ──────────────────────────────────────────────────────────────
# Keep HOST on loopback and reach the dashboard over an SSH tunnel. Do not open
# 8787 in the security group - a run costs money and writes to the spreadsheet.
HOST=127.0.0.1
PORT=8787
# openssl rand -hex 32
ADMIN_TOKEN=

# ── Schedule ──────────────────────────────────────────────────────────────
# croner resolves TIMEZONE itself, so the box clock does not need to be IST.
SCHEDULE=0 6 * * *
TIMEZONE=Asia/Kolkata
SCHEDULE_ENABLED=true

# ── Tuning ────────────────────────────────────────────────────────────────
DEFAULT_DAILY_LIMIT=13
QUERIES_PER_ROUND=3
MAX_ROUNDS=3
RETRY_ATTEMPTS=3
RETRY_BASE_MS=500

# ── Storage and logging ───────────────────────────────────────────────────
# STATE_DIR is deliberately unset: it defaults to ./state, which resolves against
# the unit's WorkingDirectory. state/ is gitignored, so upgrades leave it alone.
RUN_HISTORY=60
LOG_LEVEL=info
# json keeps journald parseable. Use pretty only when tailing by hand.
LOG_FORMAT=json

# ── Optional ──────────────────────────────────────────────────────────────
SLACK_WEBHOOK=
