# Local development. Copy to .env and fill in - Bun loads .env automatically.
#
#   cp .env.example .env
#   bun run cli auth --client-id ... --client-secret ...
#   bun run cli check
#
# For the EC2 box use deploy/campaign-research.env.example instead: systemd reads it as
# an EnvironmentFile, which has no shell quoting and no trailing comments on a value line.
#
# .env is gitignored. Never commit it.

# ── Google (OAuth only - service account keys are not supported) ──────────
# 1. Consent screen, User type INTERNAL:
#      https://console.cloud.google.com/auth/overview
#    External + Testing expires refresh tokens after 7 days. Internal does not.
# 2. Create an OAuth client, Application type "Desktop app":
#      https://console.cloud.google.com/apis/credentials
# 3. bun run cli auth --client-id <id> --client-secret <secret>
#    then paste the three values it prints below.
#
# The refresh token grants access to everything that account can open in Sheets.
# Treat it as a password.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ── Required ──────────────────────────────────────────────────────────────
# Spreadsheet id, from the URL between /d/ and /edit. The authorising account
# must be able to open it - no separate sharing step.
MASTER_EVENTS_ID=

# TinyFish Search + Fetch. Free tier, 30 requests/minute.
TINYFISH_API_KEY=

# Cloudflare Workers AI. An API token with Workers AI access - not a Worker.
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# ── Local defaults ────────────────────────────────────────────────────────
# No scheduler locally: you do not want a 06:00 run firing off your laptop and
# writing to the live spreadsheet. Trigger runs by hand instead.
SCHEDULE_ENABLED=false

STATE_DIR=./state
HOST=127.0.0.1
PORT=8787

# Leave blank locally to skip bearer auth. Set it before binding to anything
# other than 127.0.0.1: openssl rand -hex 32
ADMIN_TOKEN=

# info narrates every step. debug also lists each rejected row and HTTP request.
LOG_LEVEL=info

# pretty = human-readable console lines, json = one JSON object per line.
# Defaults to pretty when stdout is a terminal, json otherwise.
LOG_FORMAT=pretty

# ── Optional ──────────────────────────────────────────────────────────────
CAMPAIGNS_TAB=CAMPAIGNS
SEARCH_LOCATION=IN

# A reasoning model is required: the job is judging whether an organisation fits
# the brief, which small instruct models get wrong. Reasoning tokens come out of
# the same budget as the answer, so the limits below are deliberately generous -
# too small and the model spends everything thinking and returns nothing.
#   glm-5.2         quality pick, fills evidence fields, ~35s per extraction
#   gpt-oss-120b    ~8x faster but leaves attendance/event_goal empty
#   glm-4.7-flash   do not use, returns nothing
#   kimi-k2.6       do not use, 100s+ and unreliable
CF_MODEL=@cf/zai-org/glm-5.2
CF_STRUCTURED_OUTPUTS=true
MAX_QUERY_TOKENS=24000
MAX_EXTRACT_TOKENS=96000

DEFAULT_DAILY_LIMIT=13
QUERIES_PER_ROUND=3
MAX_ROUNDS=3
RETRY_ATTEMPTS=3
RETRY_BASE_MS=500
RUN_HISTORY=60

# Leave blank locally so test runs do not post into the team channel.
SLACK_WEBHOOK=
